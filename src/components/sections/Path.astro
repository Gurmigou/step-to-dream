---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import smilePhoto from "../../assets/smile.jpg";
import { finalSessionPoints, sessions } from "../../data/content";
import { site } from "../../config/site";
---

<section id="path" class="sec bg-deep">
  <div class="wrap layout">
    <div class="intro">
      <h2 class="u fs" style="--fs:34px">Який шлях</h2>
      <div class="i fs accent" style="--fs:40px">ти пройдеш</div>
      <p class="t">
        Від чесного погляду на себе — до звільнення від того, що тримає; від вибору — до перших кроків і нового вектору.
      </p>
    </div>

    <div class="sessions">
      {
        sessions.map((session) => (
          <article class:list={["card", "session", `bg-${session.tone}`]}>
            <div class="card-head">
              <span class:list={["badge", `bg-${session.badgeTone}`]}>Сесія {session.number}</span>
              <span class="duration">{session.duration}</span>
            </div>
            <h3 class="u session-title">{session.title}</h3>
            <div class="i subtitle">{session.subtitle}</div>
            <div class:list={["result", `bg-${session.resultTone}`]}>
              <div class="t result-label">Результат</div>
              <div class="i result-text">{session.result}</div>
            </div>
            <details>
              <summary class="card-head">
                <span class="pill">Що відбувається на сесії</span>
                <span class="toggle-icon" aria-hidden="true">+</span>
              </summary>
              <p class="t details">{session.details}</p>
            </details>
          </article>
        ))
      }
    </div>

    <div class="final">
      <div class="final-photo">
        <div class="frame">
          <Image src={smilePhoto} alt="Кристина усміхається" widths={[320, 640]} sizes="(min-width: 1100px) 380px, 240px" />
        </div>
        <div class="i final-accent" aria-hidden="true">своє<br />життя</div>
      </div>
      <div class="final-body">
        <span class="pill">Сесія 05 · Фінальна</span>
        <h3 class="u fs" style="--fs:44px">Я живу <span class="sr-only">своє життя</span></h3>
        <ul class="t points">
          {finalSessionPoints.map((point) => <li>{point}</li>)}
        </ul>
        <Button href={site.links.apply} label="Хочу на супровід" variant="gold" />
      </div>
    </div>
  </div>
</section>

<style>
  .layout {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-bottom: 12px;
  }

  .accent {
    color: var(--gold);
    margin-top: -10px;
  }

  .intro .t {
    max-width: 560px;
  }

  .sessions {
    display: grid;
    gap: 16px;
  }

  .session.bg-sand,
  .session.bg-cream,
  .session.bg-gold {
    color: var(--deep);
  }

  .session.bg-green {
    border: 1px solid #3d5c56;
  }

  .session .session-title {
    font-size: min(34px, 8.4vw);
    color: inherit;
  }

  .badge {
    border-radius: 999px;
    padding: 7px 16px;
    font-size: 14px;
  }

  .badge.bg-sand {
    color: var(--deep);
  }

  .duration {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
  }

  .subtitle {
    font-size: 24px;
    line-height: 1.15;
  }

  .result {
    border-radius: 14px;
    padding: 16px;
    color: var(--deep);
  }

  .result-label {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .result-text {
    font-size: 19px;
    line-height: 1.3;
  }

  .details {
    margin-top: 14px;
  }

  .final {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px 4px 0;
  }

  .final-photo {
    position: relative;
    display: flex;
    justify-content: center;
    order: 1;
  }

  .final-body {
    display: contents;
  }

  .final-body .pill {
    order: -2;
  }

  .final-body h3 {
    order: -1;
  }

  .final-body .points,
  .final-body :global(.btn) {
    order: 2;
  }

  .frame {
    width: 240px;
    height: 300px;
    border-radius: 120px 120px 16px 16px;
    overflow: hidden;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
    transform: scale(1.25);
    transform-origin: 68% 32%;
  }

  .final-accent {
    position: absolute;
    right: 0;
    bottom: -10px;
    font-size: 52px;
    color: var(--gold);
    line-height: 0.9;
    text-align: right;
  }

  .points {
    padding-left: 18px;
    margin: 16px 0 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .final-body :global(.btn) {
    margin-top: 12px;
  }

  @media (min-width: 768px) {
    .sessions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .sessions {
      gap: 20px;
    }

    .session {
      padding: 28px 28px 30px;
    }

    .final {
      display: grid;
      grid-template-columns: 420px 1fr;
      gap: 80px;
      align-items: center;
      padding-top: 80px;
    }

    .final-photo {
      order: 0;
    }

    .final-body {
      order: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .frame {
      width: 340px;
      height: 430px;
      border-radius: 170px 170px 18px 18px;
    }

    .final-accent {
      font-size: 72px;
      right: -10px;
    }

    .points .t,
    .points {
      font-size: 18px;
    }
  }
</style>
