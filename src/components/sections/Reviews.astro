---
import { reviews } from "../../data/content";
---

<section id="reviews" class="sec">
  <div class="wrap stack">
    <h2 class="u fs heading" style="--fs:32px">Історії</h2>
    <div class="i fs sub" style="--fs:36px">моїх клієнток</div>
    <p class="t note">Імена не вказую з міркувань конфіденційності.</p>

    <div class="hscroll" style="--cols:4">
      {
        reviews.map((review) => (
          <article class:list={["review", `bg-${review.tone}`]}>
            <span class="pill tag">{review.tag}</span>
            {review.kind === "quote" ? (
              <>
                <p class="i quote">{review.quote}</p>
                <p class="t caption">{review.caption}</p>
              </>
            ) : (
              <>
                <p class="t case">
                  <b>Було:</b> {review.before}
                </p>
                <p class="t case">
                  <b>Стало:</b> {review.after}
                </p>
              </>
            )}
          </article>
        ))
      }
    </div>
    <div class="swipe-hint"><span class="i">Гортай</span><span aria-hidden="true">→</span></div>
  </div>
</section>

<style>
  .stack {
    gap: 14px;
  }

  .heading {
    color: var(--green);
  }

  .sub {
    margin-top: -8px;
  }

  .note {
    font-size: 13px;
    color: var(--muted);
  }

  .review {
    border-radius: 22px;
    padding: 24px;
    width: 280px;
    min-width: 280px;
    max-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tag {
    color: var(--green);
  }

  .bg-green .tag,
  .caption {
    color: var(--sand);
  }

  .quote {
    font-size: 21px;
    line-height: 1.3;
  }

  .caption {
    font-size: 13px;
  }

  .case {
    font-size: 15px;
  }
</style>
