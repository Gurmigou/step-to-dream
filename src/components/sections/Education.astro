---
import { Image } from "astro:assets";
import certMba from "../../assets/cert-mba.jpg";
import certExtracoaching from "../../assets/cert-extracoaching.jpg";
import certIcta from "../../assets/cert-icta.jpg";

const certificates = [
  { src: certMba, alt: "Диплом Mini MBA — Coach, Mentor and Diagnostician" },
  { src: certExtracoaching, alt: "Сертифікат The Extracoaching Program" },
  { src: certIcta, alt: "Сертифікат ICTA — Enneagram Practitioner" },
];
---

<section class="sec bg-sand edu">
  <div class="wrap stack">
    <h2 class="u fs heading" style="--fs:28px">Освіта</h2>
    <div class="hscroll" style="--cols:3">
      {
        certificates.map((certificate) => (
          <a class="cert" href={certificate.src.src} target="_blank" rel="noopener">
            <Image src={certificate.src} alt={certificate.alt} widths={[400, 800]} sizes="(min-width: 1100px) 33vw, 250px" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .edu {
    padding: 44px 0;
  }

  .stack {
    gap: 18px;
  }

  .heading {
    color: var(--green) !important;
  }

  .cert {
    width: 250px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(27, 48, 44, 0.15);
  }

  .cert :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 250 / 178;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .cert:hover :global(img) {
    transform: scale(1.03);
  }

  @media (min-width: 1100px) {
    .edu {
      padding: 80px 0;
    }
  }
</style>
